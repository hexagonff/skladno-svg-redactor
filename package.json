{
  "name": "aipictures",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:library && tsc --noEmit && vite build",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "build:library": "tsx scripts/build-library.ts",
    "test:e2e": "playwright test",
    "preview:worker": "wrangler dev",
    "deploy:check": "npm run build && wrangler deploy --dry-run --outdir .wrangler/deploy",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "mobx": "^7.1.5",
    "mobx-react-lite": "^5.1.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.160.1"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
