{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "skladno",
  "main": "api/worker.ts",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"],
  },
  "vars": {
    "OPENROUTER_MODEL": "dots-studio/dots-3-note-preview:free",
  },
}
